# RecruitFlow AI 环境变量示例（占位值，勿提交真实密钥）

# ---- DeepSeek 适配器（默认真实模型） ----
# 必填：API 密钥（仅从环境变量读取）
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：自定义 API 地址，默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=
# 可选：模型名称
DEEPSEEK_MODEL=deepseek-flash
# 可选：请求超时（秒）
DEEPSEEK_TIMEOUT=60

# ---- 智谱（GLM）适配器 ----
# 必填：API 密钥（仅从环境变量读取）
ZHIPU_API_KEY=your-zhipu-api-key
# 可选：自定义 API 地址，默认 https://open.bigmodel.cn/api/paas/v4
# ZHIPU_BASE_URL=
# 可选：模型名称
ZHIPU_MODEL=glm-4.7-flash
# 可选：请求超时（秒）
ZHIPU_TIMEOUT=60

# ---- Anthropic 适配器 ----
# 必填：API 密钥（仅从环境变量读取）
ANTHROPIC_API_KEY=sk-ant-xxxx-xxxx
# 可选：自定义 API 地址（代理/兼容端点）
# ANTHROPIC_BASE_URL=
# 可选：模型名称
RECRUITFLOW_MODEL=claude-opus-5-5
# 可选：请求超时（秒）
RECRUITFLOW_TIMEOUT=60
