# RecruitFlow AI 环境变量示例（占位值，勿提交真实密钥）

# ---- DeepSeek 适配器（默认真实模型） ----
# 必填：API 密钥（仅从环境变量读取）
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：自定义 API 地址，默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=
# 可选：模型名称
DEEPSEEK_MODEL=deepseek-flash
# 可选：请求超时（秒）
DEEPSEEK_TIMEOUT=60

# ---- 智谱（GLM）适配器 ----
# 必填：API 密钥（仅从环境变量读取）
ZHIPU_API_KEY=your-zhipu-api-key
# 可选：自定义 API 地址，默认 https://open.bigmodel.cn/api/paas/v4
# ZHIPU_BASE_URL=
# 可选：模型名称
ZHIPU_MODEL=glm-4.7-flash
# 可选：请求超时（秒）
ZHIPU_TIMEOUT=60

# ---- Anthropic 适配器 ----
# 必填：API 密钥（仅从环境变量读取）
ANTHROPIC_API_KEY=sk-ant-xxxx-xxxx
# 可选：自定义 API 地址（代理/兼容端点）
# ANTHROPIC_BASE_URL=
# 可选：模型名称
RECRUITFLOW_MODEL=claude-opus-5-5
# 可选：请求超时（秒）
RECRUITFLOW_TIMEOUT=60

# ---- 公开预览（在线托管部署，如 Streamlit Community Cloud） ----
# 设为 1 开启公开预览：默认只读；真实 AI 需演示口令（服务端校验）
# RECRUITFLOW_PUBLIC_PREVIEW=0
# 演示访问口令（公开预览解锁真实 AI；未配置则只读）
# RECRUITFLOW_DEMO_PASSWORD=
# 消息长度上限（字符）
# RECRUITFLOW_MAX_MSG_LEN=500
# 调用频率限制（每窗口次数）
# RECRUITFLOW_AI_RATE_LIMIT=10
# 频率窗口（秒）
# RECRUITFLOW_AI_RATE_WINDOW_SECONDS=3600
# 总调用次数上限
# RECRUITFLOW_AI_TOTAL_LIMIT=100
# 调用限制计数库路径（默认 demo-limits.db）
# RECRUITFLOW_LIMITS_DB=demo-limits.db
